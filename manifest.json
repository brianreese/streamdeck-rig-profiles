      "States": [
        {
          "Image": "assets/action-icon"
        }
      ],
      "SupportedInMultiActions": false,
      "UUID": "com.rig.profiles.toggle"
    }
  ],
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "UUID": "com.rig.profiles",
