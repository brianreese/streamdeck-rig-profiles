{
  "Author": "Brian Reese",
  "Category": "Rig Profiles",
  "CategoryIcon": "assets/category-icon",
  "CodePath": "src/plugin.js",
  "Description": "Switch between named sim rig profiles from your Stream Deck. Each profile applies its own hardware settings and confirms them against the hardware before showing as active.",
  "Icon": "assets/plugin-icon",
  "Name": "Rig Profiles",
  "Actions": [
    {
      "Icon": "assets/action-icon",
      "Name": "Rig Profile",
      "Tooltip": "Activate one named rig profile.",
      "PropertyInspectorPath": "ui/profile-key.html",
      "States": [
        {
          "Image": "assets/action-icon",
          "TitleAlignment": "bottom"
        }
      ],
      "SupportedInMultiActions": false,
      "UUID": "com.rig.profiles.key"
    },
    {
      "Icon": "assets/action-icon",
      "Name": "Rig Mode",
      "Tooltip": "Turn a mode on or off: lighting, scripts, shared state.",
      "PropertyInspectorPath": "ui/mode-key.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "assets/action-icon"
        }
      ],
      "SupportedInMultiActions": true,
      "UUID": "com.rig.profiles.mode"
    }
  ],
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "UUID": "com.rig.profiles",
  "Version": "1.0.0",
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  }
}
